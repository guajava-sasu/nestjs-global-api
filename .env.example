# Required network binding; use the port assigned by the VPS contract.
HOST=127.0.0.1
PORT=3002
NODE_ENV=production

# MongoDB credentials belong in the VPS secret environment, never in Git.
# Main application database (default database in the URI: nestjs-global-api).
# Set this to a private production URI; the shown value is a placeholder only.
MONGODB_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/nestjs-global-api?authSource=admin
# Isolated URI for the dedicated lingots database; the app forces this dbName.
# Do not point this URI at the existing gestion_lingots database.
MONGODB_GESTION_LINGOTS_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/nestjs-global-api-lingots?authSource=admin

# Destructive HTTP DELETE routes return 403 unless explicitly enabled.
ALLOW_DESTRUCTIVE_HTTP=false

# Define only for an intentional maintenance reset/seed operation.
# CONFIRM_DB_RESET=true

# Comma-separated exact frontend origins. In production, only these are accepted.
CORS_ORIGINS=
